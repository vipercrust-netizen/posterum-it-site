generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
enum LeadStatus { NEW IN_PROGRESS DONE REJECTED }
model Lead { id Int @id @default(autoincrement()) createdAt DateTime @default(now()) name String phone String topic String? comment String? page String? status LeadStatus @default(NEW) }
model Admin { id Int @id @default(autoincrement()) login String @unique passwordHash String createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
